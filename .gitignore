# Built application files
*.apk
*.aab
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/
.build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ / Android Studio
*.iml
.idea/
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches
.idea/modules.xml
.idea/misc.xml
.idea/vcs.xml
.idea/shelf

# Keystore files (keep these out of version control)
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild/
.cxx/

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Kotlin
.kotlin/

# Xcode — per-user state (window layout, selected scheme, breakpoints).
# Covers both UserInterfaceState.xcuserstate and xcschememanagement.plist.
xcuserdata/
*.xcuserstate

# Xcode build output (build/ is already ignored above for Gradle)
DerivedData/
*.hmap
*.ipa
*.dSYM
*.dSYM.zip

# Xcode legacy per-user project files
*.pbxuser
!default.pbxuser
*.perspectivev3
!default.perspectivev3

# Swift Package Manager
.swiftpm/
Packages/

# CocoaPods / Carthage — uncomment if either is adopted
# Pods/
# Carthage/Build/

# Claude worktrees
.claude/worktrees/
.claude/scheduled_tasks.lock

# JVM heap dumps
*.hprof

# Google Cast iOS SDK — 71MB vendored binary, auto-downloaded by the Xcode
# "Compile Kotlin Framework" build phase (see iOS project) or
# "Native Mobile/scripts/fetch_cast_sdk.sh"
Native Mobile/iOS/Frameworks/GoogleCast.xcframework/
