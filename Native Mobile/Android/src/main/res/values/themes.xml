<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AGPodcast" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:statusBarColor">@color/dark_bg</item>
        <item name="android:navigationBarColor">@color/dark_bg</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Main theme colors for legacy Views (like MediaRouteButton) -->
        <item name="colorPrimary">@color/gold</item>
        <item name="colorPrimaryDark">@color/dark_bg</item>
        <item name="colorAccent">@color/gold</item>

        <!-- MediaRouter uses these to calculate contrast -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:background">@color/dark_bg</item>
    </style>
</resources>
